{
  "version": "2.0.0",
  "tasks": [
    { "label": "Test", "type": "shell", "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" }, "group": "test", "problemMatcher": [] },
    { "label": "Lint", "type": "shell", "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m ruff check .",
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] },
    { "label": "Migrate", "type": "shell", "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m alembic upgrade head",
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] }
  ]
}
