{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "jinja": true
    },
    {
      "name": "Demo pipeline (offline fixtures)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo_pipeline.py",
      "args": [
        "--depth",
        "standard"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "name": "MCP: list tools (offline)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/mcp_call.py",
      "args": [
        "list"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Demo pipeline over MCP (offline)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo_pipeline.py",
      "args": [
        "--mcp",
        "--depth",
        "standard"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}