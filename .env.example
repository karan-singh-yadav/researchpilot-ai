# Copy to .env and edit. Never commit .env.
APP_ENV=development
# SQLite works for offline dev/tests; use PostgreSQL for real deployments.
DATABASE_URL=postgresql+psycopg2://researchpilot:researchpilot@localhost:5432/researchpilot
# Comma-separated API keys accepted in the X-API-Key header. Leave empty ONLY in development.
API_KEYS=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=25
MAX_FETCH_BYTES=2000000
FETCH_TIMEOUT_SECONDS=10
# LLM provider: fake | openai (any OpenAI-compatible endpoint) | anthropic
# "fake" = deterministic, templated offline provider for demos/tests (NOT a real model).
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Optional USD per 1M tokens, for cost estimates only (leave 0 to disable)
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0
# Search: none | brave | tavily | fixture (fixture = OFFLINE synthetic data + offline page fetcher)
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_FIXTURE_PATH=
SEARCH_MAX_RESULTS_PER_QUERY=5
FETCH_MAX_REDIRECTS=4
READER_MAX_CHARS=12000
READER_MAX_WORKERS=4

# Workflow execution (Phase 4)
CHECKPOINT_PATH=./data/checkpoints.sqlite
MAX_CONCURRENT_RUNS=2
RUN_EXECUTOR=thread

# Tools over MCP (Phase 5): direct | mcp.  "mcp" spawns `python -m app.mcp.server` over stdio.
TOOL_TRANSPORT=direct
MCP_ENABLED_TOOLS=
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_CONCURRENCY=8
MCP_CALLS_PER_MINUTE=240
MCP_MAX_TEXT_CHARS=50000
MCP_MAX_EXPORT_BYTES=2000000

# Documents / RAG (Phase 6)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Embeddings: hash (offline, lexical - NOT semantic) | openai (any OpenAI-compatible /embeddings) | sentence-transformers
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=512
# Vector store: sql (default; embeddings live in the database) | chroma (optional; pip install chromadb)
VECTOR_STORE=sql
CHROMA_PATH=./data/chroma
RERANKER=none
